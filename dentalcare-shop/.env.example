# ---- Frontend (public, safe to expose: anon key is protected by RLS) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional public runtime aliases (Netlify Functions scope):
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Alternative public build key name:
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Backend ONLY (never prefix with VITE_, never commit) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook only: random 32+ character secret, never VITE_
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS origin for setup script; no path/query
SITE_URL=
RESEND_API_KEY=
ADMIN_EMAIL=
FROM_EMAIL=
